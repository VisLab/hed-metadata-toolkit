{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(python -m unittest *)",
      "Bash(pytest *)",
      "Bash(python -m ruff *)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(python -m mdformat *)",
      "Bash(mdformat *)",
      "Bash(python src/*)",
      "Bash(python --version)",
      "Bash(python -m pip list)",
      "Bash(python -m pip show *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git branch -vv)",
      "Bash(git remote -v)",
      "Bash(git ls-files *)"
    ],
    "ask": [
      "Bash(git checkout HEAD -- *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.envrc)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(git clean -fd*)",
      "Bash(git filter-branch *)",
      "Bash(pip install *)",
      "Bash(pip uninstall *)",
      "Bash(python -m pip install *)",
      "Bash(python -m pip uninstall *)",
      "Bash(python3 -m pip install *)",
      "Bash(uv pip install *)",
      "Bash(uv pip uninstall *)",
      "Bash(uvx *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(chmod *)",
      "Bash(chown *)"
    ]
  }
}
